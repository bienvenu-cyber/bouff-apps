# ---------------------------------------------------------------
# BOUFF — site web client
# Copiez ce fichier en `.env.local` et complétez les valeurs.
# ---------------------------------------------------------------

# Base BOUFF (déjà pré-remplie dans next.config.mjs, à surcharger si besoin)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_BOUFF_RESTAURANT_SLUG=bouff

# --- Clés de service internes (fournies avec la base BOUFF) ---
BOUFF_NOTIFICATIONS_TOKEN=
BOUFF_PAYMENTS_TOKEN=
# Secret à envoyer dans l'en-tête `x-bouff-cron-secret` pour déclencher les envois
BOUFF_CRON_SECRET=

# --- WhatsApp (wapiway.tech) ---
WAPIWAY_API_KEY=
WAPIWAY_INSTANCE_ID=
WAPIWAY_BASE_URL=https://api.wapiway.tech
BOUFF_PHONE_COUNTRY_CODE=229

# --- E-mails (Resend, domaine à vérifier) ---
RESEND_API_KEY=
BOUFF_EMAIL_FROM=BOUFF <commandes@votre-domaine.bj>

# --- Paiement Mobile Money (pawaPay) ---
PAWAPAY_API_TOKEN=
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
# Passez à true seulement quand la clé pawaPay est en place
NEXT_PUBLIC_PAWAPAY_ENABLED=false

# --- Cartes (facultatif, pour le suivi en direct) ---
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
