{
  "expo": {
    "name": "BOUFF Cuisine",
    "slug": "the-bouff-app-store",
    "owner": "ben229",
    "description": "The Bouff App Restaurant Store Application",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./lib/assets/images/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "thebouffappstore",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./lib/assets/images/splashTransparent.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0B0B0C",
            "image": "./lib/assets/images/splashTransparent.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos for license, vehicle plate and profile image. Please allow these to continue using the app."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio",
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#FF7A1A",
          "sounds": [
            "./lib/assets/sound/beep3.mp3"
          ]
        }
      ]
    ],
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bj.bouff.cuisine",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "$(PRODUCT_NAME) uses your location for features like finding orders nearby and tracking customer orders!",
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": true,
        "NSBluetoothAlwaysUsageDescription": "We use Bluetooth to connect to your thermal printer.",
        "NSBluetoothPeripheralUsageDescription": "We use Bluetooth to connect to your thermal printer."
      }
    },
    "android": {
      "versionCode": 87,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "bj.bouff.cuisine",
      "adaptiveIcon": {
        "foregroundImage": "./lib/assets/images/appIcon.png",
        "backgroundColor": "#0B0B0C"
      }
    },
    "extra": {
      "eas": {
        "projectId": "682bdeda-e04c-4a58-a1df-c09fab64aff9"
      },
      "router": {}
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}